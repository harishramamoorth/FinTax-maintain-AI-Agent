{
  "name": "fintax-portal",
  "version": "1.0.0",
  "private": true,
  "description": "FinTax client and staff portal (React + FastAPI)",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "setup": "node scripts/dev.mjs --setup-only",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend ci && npm --prefix frontend run build",
    "start": "node scripts/start-prod.mjs",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "node scripts/run-backend.mjs -m pytest -q",
    "migrate": "node scripts/run-backend.mjs -m alembic upgrade head",
    "admin:create": "node scripts/run-backend.mjs -m app.cli create-admin",
    "package": "python3 scripts/package.py"
  }
}
