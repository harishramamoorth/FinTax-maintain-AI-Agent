# FinTax Portal local development configuration. npm run dev copies this to .env when needed.
# Keep real credentials in an untracked .env or your deployment's secret store.
APP_ENV=development
DATABASE_URL=sqlite:///./data/fintax.db
AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional shared token for legacy NEXUS development endpoints only.
ACCESS_TOKEN=

# Optional legacy NEXUS development endpoints; not used for FinTax document processing.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
DEMO_MODE=auto
SEARCH_API_KEY=

# Docker Compose local scaffold only. Set a unique strong password before use.
POSTGRES_PASSWORD=
